# Exemple Nginx pour le reverse proxy 172.16.138.10.
# Les adresses suivent le decoupage de travail du bloc 172.16.128.0/18.
upstream site_c_web {
    server 172.16.138.11:80;
    server 172.16.138.12:80 backup;
}

server {
    listen 80;
    server_name site-c.example.invalid;

    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        proxy_pass http://site_c_web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
